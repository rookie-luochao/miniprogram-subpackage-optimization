.nut-theme-dark .nut-switch.nut-switch-close{background-color:var(--nut-dark-background4, #323233)}.nut-switch{display:inline-flex;flex:0 0 auto;align-items:center;cursor:pointer;background-color:#7b1818;background-repeat:no-repeat;background-position:center center;background-size:100% 100%;border-radius:var(--nut-switch-border-radius, 42rpx)}.nut-switch .nut-icon-loading1{width:24rpx;height:24rpx;font-size:24rpx}.nut-switch.nut-switch-close{background-color:var(--nut-switch-close-bg-color, #ebebeb)}.nut-switch .nut-switch-button{display:flex;align-items:center;justify-content:center;background:var(--nut-white, #fff);border-radius:50%;transition:transform .3s}.nut-switch .nut-switch-button .nut-switch-label{font-size:var(--nut-font-size-1, 24rpx);color:var(--nut-white, #fff)}.nut-switch .nut-switch-button .nut-switch-label.open{transform:translate(-32rpx)}.nut-switch .nut-switch-button .nut-switch-label.close{transform:translate(32rpx)}.nut-switch.nut-switch-disabled{opacity:.6}.nut-switch.nut-switch-base{min-width:var(--nut-switch-width, 72rpx);height:var(--nut-switch-height, 42rpx);overflow:hidden;line-height:var(--nut-switch-line-height, 42rpx)}.nut-switch.nut-switch-base .nut-switch-button{width:var(--nut-switch-inside-width, 26rpx);height:var(--nut-switch-inside-height, 26rpx);transform:var(--nut-switch-inside-close-transform, translateX(30%))}.nut-switch.nut-switch-base.nut-switch-open .nut-switch-button{transform:var(--nut-switch-inside-open-transform, translateX(146%))}
