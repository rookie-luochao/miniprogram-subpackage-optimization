.nut-rate{display:inline-flex}.nut-rate-item{position:relative;display:flex;flex-shrink:0;margin-right:28rpx}.nut-rate-item:last-child{margin-right:0}.nut-rate-item__icon{flex-shrink:0;color:var(--nut-rate-icon-color, #7b1818);cursor:pointer}.nut-rate-item__icon--disabled{color:var(--nut-rate-icon-void-color, var(--nut-disable-color, #ccc))}.nut-rate-item__icon--full{display:flex}.nut-rate-item__icon--half{position:absolute;top:0;left:0;display:flex;width:50%;overflow:hidden}
