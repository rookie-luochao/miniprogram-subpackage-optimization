  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "便民门诊",
    "navigationStyle": "custom",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "rpxCalcMaxDeviceWidth": 3840,
    "rpxCalcBaseDeviceWidth": 3840,
    "rpxCalcIncludeWidth": 750
  },
  "tabBar": {
    "color": "#666666",
    "selectedColor": "#C9746A",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "iconPath": "./static/home.png",
        "selectedIconPath": "./static/home_active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/message/index",
        "iconPath": "./static/message.png",
        "selectedIconPath": "./static/message_active.png",
        "text": "消息"
      },
      {
        "pagePath": "pages/mine/index",
        "iconPath": "./static/mine.png",
        "selectedIconPath": "./static/mine_active.png",
        "text": "我的"
      }
    ]
  },
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["pages-service-package"]
    },
    "pages/message/index": {
      "network": "all",
      "packages": ["pages-chat"]
    },
    "pages-service-package/service-package-detail/index": {
      "network": "all",
      "packages": ["pages-chat"]
    },
    "pages-reservation/reservation/index": {
      "network": "all",
      "packages": ["pages-chat"]
    },
    "pages-chat/chat/index": {
      "network": "all",
      "packages": [
        "pages-vocational",
        "pages-reservation",
        "pages-health-records"
      ]
    },
    "pages/mine/index": {
      "network": "all",
      "packages": [
        "pages-product-order",
        "pages-inquiry-order",
        "pages-patient",
        "pages-address",
        "pages-prescription",
        "pages-evaluate",
        "pages-after-sales",
        "pages-settings"
      ]
    }
  },
  "usingComponents": {}
}
